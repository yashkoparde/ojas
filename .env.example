# GROQ_API_KEY: Recommended! Free ultra-fast API key from https://console.groq.com
# Powers multilingual translation, medication interaction checks, weekly reports & schedule assistant
GROQ_API_KEY="gsk_..."

# (Optional) Alternative model: llama-3.3-70b-versatile (default) or llama-3.1-8b-instant
GROQ_MODEL="llama-3.3-70b-versatile"

# GEMINI_API_KEY: Optional alternative if using Google Gemini
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted
APP_URL="http://localhost:3000"
